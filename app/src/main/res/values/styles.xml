<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="theme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Base.Theme.F" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="myBackground">?attr/colorSurface</item>
        <item name="colorPrimary">@color/my_primary</item>
        <item name="colorOnPrimary">@color/my_on_primary</item>
        <item name="colorPrimaryContainer">@color/my_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/my_on_primary_container</item>
        <item name="colorSecondary">@color/my_secondary</item>
        <item name="colorOnSecondary">@color/my_on_secondary</item>
        <item name="colorSecondaryContainer">@color/my_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/my_on_secondary_container</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="bottomSheetDialogTheme">@style/Theme.F.BottomSheetDialog</item>
    </style>

    <!-- Light mode: dark status & navigation bar icons -->
    <style name="Theme.F" parent="Base.Theme.F">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Widget.F.StatCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/my_surface_container</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.F.StatusBanner" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.F.ListItemCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/my_surface_container_low</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider_color</item>
    </style>

    <style name="Theme.F.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.F.BottomSheet</item>
    </style>

    <style name="Widget.F.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.F.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.F.BottomSheet" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

</resources>